EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=stooping-club-berkeley.myshopify.com
EXPO_PUBLIC_SHOPIFY_SHOP_ID=74832183474
EXPO_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token
EXPO_PUBLIC_SHOPIFY_API_VERSION=2024-10
EXPO_PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your-customer-account-client-id
# Register this callback in Shopify Admin → Headless → Customer Account API:
# shop.74832183474.app://account/callback

# Public URL of the deployed account-deletion endpoint (see server/api/delete-account.mjs).
# The Shopify Admin API call happens server-side; the app only calls this URL.
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://your-backend.example.com/api/delete-account
